{
  "name": "opencode-recent-changes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cursor-style review of recent agent changes for OpenCode Desktop",
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
